# Copy to .env.local for Next.js and fill in. Use the same values in the background
# worker's environment (e.g. Trigger.dev). Never commit real values to this file.

# --- Foundation (in use) ---------------------------------------------------------

# MongoDB connection string (Atlas or self-hosted). Required.
MONGODB_URI=
# Optional database name override; otherwise the name in MONGODB_URI is used.
MONGODB_DB=

# Exact browser origin, e.g. http://localhost:3000 or https://app.example.com.
# Required in production; mutations are rejected from any other origin.
APP_BASE_URL=http://localhost:3000

# --- Providers (Phase 2+; not read by the app yet) --------------------------------

OPENAI_API_KEY=
# Set explicit model IDs available to your account (prompt model must support structured output).
OPENAI_PROMPT_MODEL=gpt-5.5
OPENAI_SEARCH_MODEL=gpt-5.5
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-3.8-flash
TAVILY_API_KEY=

# --- Background jobs (Phase 2+) ----------------------------------------------------

TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# --- Audit limits and access (Phase 2+) --------------------------------------------

# Private beta signup / audit access code. Required for production collection.
AUDIT_ACCESS_TOKEN=
# Generated questions per quick audit (15–25). Projects use their approved set.
AUDIT_MAX_PROMPTS=15
# Hard per-scan request limit; approved prompts × selected providers must fit (max 451).
AUDIT_MAX_CALLS=46
AUDIT_CONCURRENCY=2
AUDIT_DAILY_LIMIT=10
# Planning reservations, NOT a guaranteed provider billing cap. Configure account-level limits too.
AUDIT_BUDGET_CENTS=300
AUDIT_CALL_RESERVE_CENTS=5
