# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string (Atlas or self-hosted). Required.
MONGODB_URI=
# Optional database name override; otherwise the name in MONGODB_URI is used.
MONGODB_DB=

# Exact browser origin, e.g. http://localhost:3000 or https://app.example.com.
# Required in production; mutations are rejected from any other origin.
APP_BASE_URL=http://localhost:3000

# Provider keys (OpenAI, Gemini, SerpApi) are added here as each integration is implemented.
